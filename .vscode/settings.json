{
    "editor.bracketPairColorization.enabled": true,
    "editor.guides.indentation": false,
    "editor.largeFileOptimizations": false,
    "editor.lineNumbers": "on",
    "editor.matchBrackets": "never",
    "editor.renderLineHighlight": "line",
    "editor.renderWhitespace": "all",
    "editor.scrollbar.horizontal": "hidden",
    "editor.scrollbar.vertical": "hidden",
    "editor.scrollBeyondLastLine": false,
    "editor.showFoldingControls": "mouseover",
    "editor.smoothScrolling": true,
    "editor.unicodeHighlight.nonBasicASCII": false,
    "editor.wordWrap": "on",
    "editor.cursorBlinking": "smooth",
    "editor.cursorSmoothCaretAnimation": "on",
    "editor.fontSize": 18,
    "editor.minimap.autohide": "none",
    "editor.minimap.enabled": false,
    "editor.minimap.renderCharacters": false,
    "editor.minimap.scale": 2,
    "editor.minimap.showSlider": "mouseover",
    "files.autoGuessEncoding": true,
    "workbench.layoutControl.enabled": true,
    "workbench.layoutControl.type": "menu",
    "workbench.list.smoothScrolling": true,
    "workbench.navigationControl.enabled": false,
    "workbench.activityBar.location": "hidden",
    "workbench.colorTheme": "Monokai",
    "workbench.iconTheme": "vscode-icons",
    "workbench.statusBar.visible": false,
    "breadcrumbs.enabled": false,
    "workbench.editor.editorActionsLocation": "hidden",
    "workbench.editor.showIcons": false,
    "workbench.editor.tabActionCloseVisibility": false,
    "workbench.colorCustomizations": {
        // "focusBorder": "#00000000"
    },
    "window.commandCenter": false,
    "window.density.editorTabHeight": "compact",
    "explorer.confirmDelete": false,
    "explorer.confirmDragAndDrop": false,
    "explorer.confirmPasteNative": false,
    "debug.showBreakpointsInOverviewRuler": true,
    "chat.disableAIFeatures": true,
    // =============================================
    // LaTeX Workshop ==============================
    // =============================================
    // 启用公式鼠标悬停预览
    "latex-workshop.hover.preview.enabled": true,
    // 设置编译输出目录，避免输出文件污染根目录
    "latex-workshop.latex.outDir": "%DIR%/build",
    // 设置 vscode 编译 tex 文档时的默认编译链
    "latex-workshop.latex.recipe.default": "first",
    "latex-workshop.latex.recipes": [
        {
            "name": "latexmk",
            "tools": [
                "latexmk"
            ]
        }
    ],
    "latex-workshop.latex.tools": [
        {
            "name": "latexmk",
            "command": "latexmk",
            "args": [
                "-synctex=1",
                "-interaction=nonstopmode",
                "-file-line-error",
                "-pdfxe",
                "-outdir=%OUTDIR%",
                "%DOC%"
            ],
            "env": {}
        }
    ],
    // tex 文件浏览器
    "latex-workshop.view.pdf.viewer": "tab",
    // 自动编译 tex 文件
    "latex-workshop.latex.autoBuild.run": "never",
    // 显示错误
    "latex-workshop.message.error.show": false,
    // 显示警告
    "latex-workshop.message.warning.show": false,
    // 从使用的包中自动补全命令和环境
    "latex-workshop.intellisense.package.enabled": true,
    // 自动清理中间文件
    "latex-workshop.latex.clean.fileTypes": [
        "*.aux",
        "*.bbl",
        "*.blg",
        "*.idx",
        "*.ind",
        "*.lof",
        "*.lot",
        "*.out",
        "*.toc",
        "*.acn",
        "*.acr",
        "*.alg",
        "*.glg",
        "*.glo",
        "*.gls",
        "*.ist",
        "*.fls",
        "*.log",
        "*.fdb_latexmk"
    ],
    "latex-workshop.latex.autoClean.run": "onFailed",
    // 用于反向同步的内部查看器的键绑定
    "latex-workshop.view.pdf.internal.synctex.keybinding": "ctrl-click",
    // =============================================
    // Word Count CJK ==============================
    // =============================================
    "wordcount_cjk.statusBarTextTemplate": "共 ${total - whitespace} 非空白字符",
    "wordcount_cjk.statusBarTooltipTemplate": "中文字数：\\t\\t${cjk}\\n非 ASCII 字符数：\\t${total - ascii}\\n英文单词数：\\t\\t${en_words}\\n非空白字符数：\\t${total - whitespace}\\n总字符数：\\t\\t${total}"
}